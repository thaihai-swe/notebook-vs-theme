            "overflow": "hidden !important"
        },
        ".chat-input-container .monaco-inputbox": {
            "background-color": "color-mix(in srgb, var(--vscode-input-background, var(--vscode-sideBar-background)) 58%, transparent) !important"
        },
        ".interactive-input-part .monaco-editor": {
            "overflow": "visible !important"
        },
        ".notebookOverlay": {
            "border-radius": "0 0 var(--nb-panel-radius) var(--nb-panel-radius) !important",
            "clip-path": "inset(0 18px var(--nb-panel-gap) var(--nb-panel-gap) round 0 0 var(--nb-panel-radius) var(--nb-panel-radius)) !important",
            "isolation": "isolate",
            "transform": "translateZ(0)",
            "contain": "paint"
        },
        ".monaco-hover": {
            "border-radius": "var(--nb-widget-radius) !important",
            "background-color": "var(--nb-glass-overlay) !important",
            "backdrop-filter": "var(--nb-blur-regular) !important",
            "-webkit-backdrop-filter": "var(--nb-blur-regular) !important",
            "border": "var(--nb-hairline) !important",
            "box-shadow": "var(--nb-elev-3), var(--nb-specular-strong) !important",
            "overflow": "hidden !important",
            "animation": "nb-emerge var(--nb-motion-base) var(--nb-ease-soft) !important"
        },
        ".suggest-widget": {
            "border-radius": "var(--nb-widget-radius) !important",
            "overflow": "hidden !important",
            "background-color": "var(--nb-glass-overlay) !important",
            "backdrop-filter": "var(--nb-blur-regular) !important",
            "-webkit-backdrop-filter": "var(--nb-blur-regular) !important",
            "border": "var(--nb-hairline) !important",
            "box-shadow": "var(--nb-elev-3), var(--nb-specular-strong) !important",
            "animation": "nb-emerge var(--nb-motion-base) var(--nb-ease-soft) !important"
        },
        ".context-view": {
            "border-radius": "var(--nb-widget-radius) !important",
            "overflow": "hidden !important"
        },
        ".monaco-menu": {
            "border-radius": "var(--nb-widget-radius) !important",
            "background-color": "var(--nb-glass-overlay) !important",
            "backdrop-filter": "var(--nb-blur-regular) !important",
            "-webkit-backdrop-filter": "var(--nb-blur-regular) !important",
            "border": "var(--nb-hairline) !important",
            "box-shadow": "var(--nb-elev-3), var(--nb-specular-strong) !important",
            "overflow": "hidden !important"
        },
        ".monaco-menu .monaco-action-bar .action-item .action-menu-item:hover, .monaco-menu .monaco-action-bar .action-item .action-menu-item.focused": {
            "border-radius": "var(--nb-item-radius) !important",
            "box-shadow": "var(--nb-specular) !important"
        },
        // ------------------------------------------------------------------
        // Motion — spring enter / exit
        // ------------------------------------------------------------------
        "@keyframes nb-emerge": {
            "0%": {
                "opacity": "0",
                "transform": "translateY(8px) scale(0.985)",
                "filter": "blur(5px)"
            },
            "70%": {
                "transform": "translateY(0) scale(1)"
            },
            "100%": {
                "opacity": "1",
                "transform": "translateY(0) scale(1)",
                "filter": "blur(0)"
            }
        },
        "@keyframes nb-notify": {
            "0%": {
                "opacity": "0",
                "transform": "translateX(14px) scale(0.98)",
                "filter": "blur(4px)"
            },
            "70%": {
                "transform": "translateX(0) scale(1)"
            },
            "100%": {
                "opacity": "1",
                "transform": "translateX(0) scale(1)",
                "filter": "blur(0)"
            }
        },
        "@keyframes nb-spotlight": {
            "0%": {
                "opacity": "0",
                "transform": "translateY(-10px) scale(0.98)",
                "filter": "blur(8px)"
            },
            "65%": {
                "transform": "translateY(0) scale(1)"
            },
            "100%": {
                "opacity": "1",
                "transform": "translateY(0) scale(1)",
                "filter": "blur(0)"
            }
        },
        // Extensions list
        ".extensions-list .monaco-list-row": {
            "border-radius": "var(--nb-card-radius) !important",
            "transition": "transform var(--nb-motion-fast) var(--nb-ease-spring), box-shadow var(--nb-motion-base) var(--nb-ease-spring) !important"
        },
        ".extensions-list .monaco-list-row:hover": {
            "transform": "translateY(-1px) !important",
            "box-shadow": "var(--nb-elev-1), var(--nb-specular) !important"
        },
        // Folder tree item spacing
        ".explorer-folders-view .monaco-tl-row": {
            "padding-top": "1px !important",
            "padding-bottom": "1px !important"
        },
        // Search & Replace widgets
        ".monaco-editor .find-widget": {
            "border-radius": "var(--nb-widget-radius) !important",
            "border": "var(--nb-hairline) !important",
            "background-color": "var(--nb-glass-overlay) !important",
            "backdrop-filter": "var(--nb-blur-regular) !important",
            "-webkit-backdrop-filter": "var(--nb-blur-regular) !important",
            "box-shadow": "var(--nb-elev-3), var(--nb-specular-strong) !important",
            "overflow": "hidden !important"
        },
        ".monaco-editor .find-widget .replace-part": {
            "display": "flex !important",
            "width": "100% !important",
            "max-width": "none !important"
        },
        ".monaco-editor .find-widget .replace-input": {
            "flex": "1 1 auto !important",
            "width": "100% !important",
            "max-width": "none !important",
            "min-width": "0 !important"
        },
        ".monaco-editor .find-widget .replace-input .monaco-findInput": {
            "width": "100% !important",
            "box-sizing": "border-box !important"
        },
        ".search-view .search-container, .search-view .replace-container": {
            "display": "flex !important",
            "width": "100% !important",
            "max-width": "none !important"
        },
        ".search-view .search-container .monaco-findInput, .search-view .replace-container .monaco-findInput": {
            "flex": "1 1 auto !important",
            "width": "100% !important",
            "max-width": "none !important",
            "min-width": "0 !important",
            "height": "28px !important",
            "box-sizing": "border-box !important",
            "border": "2px solid color-mix(in srgb, var(--vscode-widget-border, var(--vscode-focusBorder)) 74%, transparent) !important",
            "box-shadow": "inset 0 0 0 1px color-mix(in srgb, var(--vscode-foreground) 8%, transparent), var(--nb-specular) !important"
        },
        ".search-view .search-container:focus-within .monaco-findInput, .search-view .replace-container:focus-within .monaco-findInput": {
            "border": "var(--nb-border-focus) !important",
            "box-shadow": "var(--nb-focus-ring), var(--nb-specular) !important"
        },
        ".search-view .replace-container .replace-input": {
            "flex": "1 1 auto !important",
            "width": "100% !important",
            "max-width": "none !important",
            "min-width": "0 !important"
        },
        // Sidebar buttons
        ".part.sidebar .monaco-button": {
            "border-radius": "var(--nb-input-radius) !important"
        },
        // Terminal tabs UI layout
        ".split-view-view:has(.terminal-tabs-entry)": {
            "min-width": "220px !important",
            "border-bottom": "none !important"
        },
        ".split-view-view:has(.terminal-tabs-entry) .monaco-list-row": {
            "border-radius": "var(--nb-item-radius) !important",
            "margin-right": "16px !important",
            "width": "calc(100% - 16px) !important"
        },
        // Dropdown separator cleanup
        ".monaco-button-dropdown-separator": {
            "display": "none !important",
            "background": "transparent !important",
            "background-color": "transparent !important",
            "width": "0 !important",
            "opacity": "0 !important"
        },
        // Welcome / empty editor polish
        ".editor-group-container.empty .editor-group-watermark": {
            "opacity": "0.72 !important"
        },
        // Reduced motion — fully static fallback
        "@media (prefers-reduced-motion: reduce)": {
            ".monaco-workbench": {
                "--nb-motion-fast": "0ms !important",
                "--nb-motion-base": "0ms !important",
                "--nb-motion-slow": "0ms !important",
                "--nb-motion-page": "0ms !important"
            },
            ".monaco-workbench, .monaco-workbench *": {
                "animation": "none !important",
                "animation-duration": "0s !important",
                "animation-delay": "0s !important",
                "transition": "none !important",
                "transition-duration": "0s !important",
                "transition-delay": "0s !important",
                "transform": "none !important",
                "scroll-behavior": "auto !important"
            }
        }
    },
    // ======================================================================
    // 14. Language-specific settings
    // ======================================================================
    "[javascript]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true
    },
    "[typescript]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true
    },
    "[typescriptreact]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true
    },
    "[python]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "[html]": {
        "editor.tabSize": 2
    },
    "[css]": {
        "editor.tabSize": 2
    },
    "[json]": {
        "editor.tabSize": 4
    },
    "[jsonc]": {
        "editor.tabSize": 4
    },
    "workbench.editor.tabActionLocation": "right",
    // ======================================================================
