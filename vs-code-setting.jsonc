        },
        ".monaco-breadcrumbs:hover, .monaco-breadcrumbs:focus-within": {
            "opacity": "1 !important",
            "background-color": "color-mix(in srgb, var(--vscode-breadcrumb-background, var(--vscode-editor-background)) 64%, transparent) !important",
            "box-shadow": "var(--nb-elev-1), var(--nb-specular) !important"
        },
        ".monaco-icon-label.file-icon::before": {
            "filter": "drop-shadow(0 0 1.5px color-mix(in srgb, currentColor 35%, transparent)) !important",
            "opacity": "1 !important"
        },
        // ------------------------------------------------------------------
        // Command center — liquid capsule
        // ------------------------------------------------------------------
        ".command-center-center": {
            "border-radius": "var(--nb-pill-radius) !important",
            "overflow": "hidden !important",
            "border": "var(--nb-hairline) !important",
            "background-color": "color-mix(in srgb, var(--vscode-sideBar-background) 38%, transparent) !important",
            "backdrop-filter": "var(--nb-blur-thin) !important",
            "-webkit-backdrop-filter": "var(--nb-blur-thin) !important",
            "box-shadow": "var(--nb-elev-1), var(--nb-specular) !important",
            "transition": "border-color var(--nb-motion-base) var(--nb-ease-spring), background-color var(--nb-motion-base) var(--nb-ease-spring), box-shadow var(--nb-motion-base) var(--nb-ease-spring), transform var(--nb-motion-fast) var(--nb-ease-spring) !important"
        },
        ".command-center-center:hover, .command-center-center:focus-within": {
            "border-color": "color-mix(in srgb, var(--vscode-commandCenter-activeBorder, var(--vscode-focusBorder)) 50%, rgba(255, 255, 255, 0.28)) !important",
            "background-color": "color-mix(in srgb, var(--vscode-sideBar-background) 52%, transparent) !important",
            "box-shadow": "0 0 16px color-mix(in srgb, var(--vscode-focusBorder) 28%, transparent), var(--nb-elev-2), var(--nb-specular-strong) !important",
            "transform": "translateY(-1px) !important"
        },
        ".command-center-center:active": {
            "transform": "scale(0.985) !important"
        },
        ".command-center-center *": {
            "border-radius": "var(--nb-pill-radius) !important"
        },
        // ------------------------------------------------------------------
