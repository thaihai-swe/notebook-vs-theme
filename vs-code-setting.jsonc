// ============================================================================
// Hallmark · pre-emit critique: P5 H5 E5 S5 R5 V5
// Hallmark · genre: modern-minimal · macrostructure: Workbench · theme: Note Book Glass Paper
// Hallmark · studied: no · audience: developers · use: long-session coding · tone: technical
// Purpose: Warm, low-glare chrome with stable focus states for long-session readability.
// Glass Paper: translucent chrome only where it communicates hierarchy; no decorative glow.
// Motion: OS-adaptive by default; reduced-motion mode becomes fully static.
// Notes:
// - This file is JSONC, not strict JSON. VS Code settings.json supports comments.
// - Keep this as User Settings unless you intentionally want it project-specific.
// - The custom-ui-style.stylesheet section requires your Custom UI Style extension.
// - If a font is not installed, VS Code falls back to the next font in the list.
// - Reload Window after Custom UI Style changes (or run "Custom UI Style: Reload").
// ============================================================================
{
    "window.zoomLevel": 1.2,
    "extensions.allowed": {
        "anthropic.claude-code": false,
        "*": true
    },
    // ======================================================================
    // Tab management
    // ======================================================================
    "workbench.editor.tabActionCloseVisibility": true,
    "workbench.editor.tabActionUnpinVisibility": true,
    // ======================================================================
    // Quick navigation
    // ======================================================================
    "workbench.quickOpen.closeOnFocusLost": true,
    "workbench.quickOpen.preserveInput": true,
    // ======================================================================
    // 1. Window, startup, and focus behavior
    // ----------------------------------------------------------------------
    // Liquid glass shell: custom title bar, command center as pill search,
    // Motion follows the OS reduce-motion setting; comfort takes priority over flourish.
    // ======================================================================
    "zenMode.centerLayout": false,
    "zenMode.fullScreen": false,
    "zenMode.hideActivityBar": false,
    "zenMode.hideLineNumbers": false,
    "zenMode.hideStatusBar": false,
    "zenMode.restore": true,
    "workbench.startupEditor": "welcomePage",
    "workbench.iconTheme": "material-icon-theme",
    "window.autoDetectColorScheme": true,
    "workbench.preferredLightColorTheme": "Note Book Minimal",
    "workbench.preferredDarkColorTheme": "Note Book Solarized Dark",
    "window.title": "${dirty}${activeEditorShort}${separator}${rootName}${separator}${appName}",
    "window.titleBarStyle": "custom",
    "window.commandCenter": true,
    "workbench.layoutControl.enabled": false,
    "window.restoreWindows": "all",
    // ======================================================================
    // 2. Editor scrollbar and minimap
    // ----------------------------------------------------------------------
    // Thin floating rails; keep minimap and scrollbar readable by default.
    // ======================================================================
    "editor.scrollbar.vertical": "visible",
    "editor.scrollbar.horizontal": "auto",
    "editor.scrollbar.verticalScrollbarSize": 30,
    "editor.scrollbar.horizontalScrollbarSize": 16,
    "editor.minimap.enabled": true,
    "editor.minimap.side": "right",
    "editor.minimap.scale": 1,
    "editor.minimap.size": "proportional",
    "editor.minimap.renderCharacters": false,
    "editor.minimap.maxColumn": 120,
    "editor.minimap.showSlider": "mouseover",
    // ======================================================================
    // 3. Editor behavior and typography
    // ----------------------------------------------------------------------
    // Long-session comfort. Clear text, generous leading, and low motion.
    // ======================================================================
    // Islands Dark font contract: IBM Plex Mono editor, Bear Sans UI chrome.
    "editor.fontFamily": "'IBM Plex Mono', 'JetBrains Mono', 'JetBrainsMono Nerd Font',  'Monaspace Neon', 'Fira Code', 'Menlo', 'Monaco', monospace",
    "editor.fontSize": 16,
    "editor.fontWeight": "400",
    "editor.lineHeight": 1.8,
    "editor.letterSpacing": 0.15,
    "editor.fontLigatures": "'calt', 'liga', 'ss01', 'ss02', 'ss03', 'ss04', 'ss05', 'ss06', 'ss07', 'ss08'",
    "editor.cursorStyle": "line",
    "editor.cursorBlinking": "solid",
    "editor.cursorSmoothCaretAnimation": "off",
    "editor.cursorWidth": 2,
    "editor.mouseWheelZoom": false,
    "editor.padding.top": 16,
    "editor.padding.bottom": 20,
    "editor.smoothScrolling": false,
    "editor.scrollBeyondLastColumn": 3,
    "editor.scrollPredominantAxis": true,
    "editor.fastScrollSensitivity": 5,
    "editor.mouseWheelScrollSensitivity": 1,
    "editor.cursorSurroundingLines": 8,
    "editor.cursorSurroundingLinesStyle": "default",
    "editor.scrollBeyondLastLine": false,
    "editor.wordWrap": "off",
    "editor.wrappingIndent": "same",
    "editor.renderLineHighlight": "line",
    "editor.renderFinalNewline": "dimmed",
    "editor.renderWhitespace": "selection",
    "editor.renderControlCharacters": false,
    "editor.copyWithSyntaxHighlighting": false,
    "editor.dragAndDrop": true,
    "editor.stickyTabStops": true,
    "editor.largeFileOptimizations": true,
    "editor.accessibilitySupport": "auto",
    // Eye-care: less constant glow, clear column anchors, calmer highlights.
    "editor.matchBrackets": "near",
    "editor.occurrencesHighlight": "singleFile",
    "editor.selectionHighlight": true,
    "editor.renderLineHighlightOnlyWhenFocus": true,
    "editor.overviewRulerBorder": false,
    "editor.hideCursorInOverviewRuler": true,
    // Formatting and save actions.
    "editor.formatOnPaste": true,
    "editor.formatOnSave": true,
    "editor.formatOnType": false,
    "editor.codeActionsOnSave": {
        "source.fixAll": "explicit",
        "source.organizeImports": "explicit"
    },
    // Unicode safety.
    "editor.unicodeHighlight.ambiguousCharacters": true,
    "editor.unicodeHighlight.invisibleCharacters": true,
    "editor.unicodeHighlight.nonBasicASCII": false,
    // ======================================================================
    // 4. Suggestions, hints, hover, and code navigation
    // ======================================================================
    "editor.suggest.preview": true,
    "editor.suggest.previewMode": "prefix",
    "editor.suggest.insertMode": "replace",
    "editor.suggest.matchOnWordStartOnly": false,
    "editor.suggestSelection": "recentlyUsedByPrefix",
    "editor.acceptSuggestionOnCommitCharacter": false,
    "editor.acceptSuggestionOnEnter": "smart",
    "editor.suggest.localityBonus": true,
    "editor.suggest.showStatusBar": true,
    "editor.snippetSuggestions": "top",
    "editor.tabCompletion": "on",
    "editor.quickSuggestions": {
        "other": true,
        "comments": true,
        "strings": true
    },
    "editor.inlineSuggest.enabled": true,
    "editor.inlineSuggest.showToolbar": "onHover",
    "editor.inlineSuggest.suppressSuggestions": false,
    "editor.parameterHints.enabled": true,
    "editor.parameterHints.cycle": true,
    "editor.linkedEditing": true,
    "editor.hover.enabled": "on",
    "editor.hover.delay": 300,
    "editor.hover.sticky": true,
    "editor.codeLens": false,
    "editor.codeLensFontSize": 14,
    "editor.inlayHints.enabled": "offUnlessPressed",
    "editor.inlayHints.fontSize": 14,
    "editor.inlayHints.padding": true,
    "editor.inlayHints.maximumLength": 40,
    // ======================================================================
    // 5. Indent guides, bracket guides, and sticky scroll
    // ======================================================================
    "editor.guides.indentation": true,
    "editor.guides.highlightActiveIndentation": "always",
    "editor.guides.bracketPairs": "active",
    "editor.guides.bracketPairsHorizontal": false,
    "editor.guides.highlightActiveBracketPair": true,
    "editor.bracketPairColorization.enabled": true,
    "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
    "editor.stickyScroll.enabled": true,
    "editor.stickyScroll.maxLineCount": 3,
    // ======================================================================
    // 6. Breadcrumbs
    // ======================================================================
    "breadcrumbs.enabled": true,
    "breadcrumbs.filePath": "on",
    "breadcrumbs.symbolPath": "on",
    "breadcrumbs.icons": true,
    "breadcrumbs.showArrays": true,
    "breadcrumbs.showBooleans": true,
    "breadcrumbs.showClasses": true,
    "breadcrumbs.showConstants": true,
    "breadcrumbs.showConstructors": true,
    "breadcrumbs.showEnumMembers": true,
    "breadcrumbs.showEnums": true,
    "breadcrumbs.showFields": true,
    "breadcrumbs.showFiles": true,
    "breadcrumbs.showFunctions": true,
    "breadcrumbs.showInterfaces": true,
    "breadcrumbs.showMethods": true,
    "breadcrumbs.showModules": true,
    "breadcrumbs.showObjects": true,
    "breadcrumbs.showPackages": true,
    "breadcrumbs.showProperties": true,
    "breadcrumbs.showStructs": true,
    "breadcrumbs.showVariables": true,
    // ======================================================================
    // 7. Workbench tabs and editor management
    // ----------------------------------------------------------------------
    // Floating glass cards, stable tabs, refined spring motion unless OS reduce-motion is on.
    // ======================================================================
    "workbench.sideBar.location": "left",
    "workbench.statusBar.visible": true,
    "workbench.reduceMotion": "user",
    "workbench.editor.emptyWindowText": "off",
    "workbench.settings.useSplitJSON": false,
    "workbench.editor.enablePreview": false,
    "workbench.editor.showTabs": "multiple",
    "workbench.editor.pinnedTabsOnSeparateRow": false,
    "workbench.editor.pinnedTabSizing": "compact",
    "workbench.editor.tabSizing": "fit",
    "workbench.editor.wrapTabs": false,
    "workbench.editor.tabCloseButton": "right",
    "workbench.editor.alwaysShowEditorActions": false,
    "workbench.editor.showIcons": true,
    "workbench.editor.highlightModifiedTabs": true,
    "workbench.editor.labelFormat": "short",
    "workbench.editor.restoreViewState": true,
    "workbench.editor.closeOnFileDelete": true,
    "workbench.editor.decorations.colors": true,
    "workbench.editor.decorations.badges": true,
    "workbench.editor.focusRecentEditorAfterClose": true,
    "workbench.editor.revealIfOpen": true,
    "workbench.editor.closeEmptyGroups": true,
    "workbench.editor.splitSizing": "split",
    "workbench.editor.limit.enabled": true,
    "workbench.editor.limit.value": 10,
    "workbench.editor.limit.perEditorGroup": true,
    "editor.dimUnfocusedEditors": false,
    // ======================================================================
    // 8. Explorer / solution-view behavior
    // ======================================================================
    "workbench.tree.indent": 16,
    "workbench.tree.renderIndentGuides": "always",
    "workbench.tree.enableStickyScroll": true,
    "workbench.tree.expandMode": "singleClick",
    "workbench.list.smoothScrolling": true,
    "workbench.list.keyboardNavigation": "highlight",
    "explorer.autoReveal": "focusNoScroll",
    "explorer.incrementalNaming": "smart",
    "explorer.confirmDragAndDrop": true,
    "explorer.confirmDelete": true,
    "explorer.confirmPasteNative": false,
    "explorer.compactFolders": false,
    "explorer.sortOrder": "type",
    "explorer.decorations.badges": true,
    "explorer.decorations.colors": true,
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.expand": false,
    "explorer.fileNesting.patterns": {
        "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lock, bun.lockb, .npmrc, .yarnrc.yml",
        "tsconfig.json": "tsconfig.*.json",
        "vite.config.*": "vitest.config.*, playwright.config.*, cypress.config.*",
        "next.config.*": "next-env.d.ts, middleware.*, instrumentation.*",
        "tailwind.config.*": "postcss.config.*, components.json",
        "eslint.config.*": ".eslintignore",
        "prettier.config.*": ".prettierignore",
        "README.md": "CHANGELOG.md, LICENSE, SECURITY.md, CODE_OF_CONDUCT.md, CONTRIBUTING.md",
        "Dockerfile": ".dockerignore, docker-compose*.yml, compose*.yml",
        ".env": ".env.*, !.env.example"
    },
    // ======================================================================
    // 9. Search, files, excludes, and performance
    // ======================================================================
    "search.searchOnType": false,
    "search.showLineNumbers": true,
    "search.decorations.colors": true,
    "search.collapseResults": "auto",
    "search.smartCase": true,
    "search.useIgnoreFiles": true,
    "search.useGlobalIgnoreFiles": true,
    "search.quickOpen.includeSymbols": true,
    "search.searchEditor.doubleClickBehaviour": "goToLocation",
    "files.autoSave": "onFocusChange",
    "files.autoSaveDelay": 1000,
    "files.trimTrailingWhitespace": true,
    "files.trimFinalNewlines": true,
    "files.insertFinalNewline": true,
    "files.eol": "\n",
    "files.simpleDialog.enable": false,
    "files.hotExit": "onExitAndWindowClose",
    "files.restoreUndoStack": true,
    "search.exclude": {
        "**/.angular": true,
        "**/.svelte-kit": true,
        "**/.astro": true,
        "**/.output": true,
        "**/.serverless": true,
        "**/.pnpm-store": true,
        "**/node_modules": true,
        "**/dist": true,
        "**/build": true,
        "**/.venv": true,
        "**/venv": true,
        "**/__pycache__": true,
        "**/.pytest_cache": true,
        "**/.next": true,
        "**/.nuxt": true,
        "**/.turbo": true,
        "**/.cache": true,
        "**/.mypy_cache": true,
        "**/.ruff_cache": true,
        "**/.tox": true,
        "**/.parcel-cache": true
    },
    "files.exclude": {
        "**/.git": true,
        "**/.DS_Store": true,
        "**/dist": true,
        "**/build": true,
        "**/.vscode": false,
        "**/.idea": true,
        "**/*.log": true,
        "**/coverage": true,
        ".pytest_cache": true,
        "__pycache__": true,
        "**/__pycache__": true,
        "**/.next": true,
        "**/.nuxt": true,
        "**/.turbo": true,
        "**/.cache": true,
        "**/.mypy_cache": true,
        "**/.ruff_cache": true,
        "**/.tox": true,
        "**/.parcel-cache": true
    },
    "files.watcherExclude": {
        "**/.angular/**": true,
        "**/.svelte-kit/**": true,
        "**/.astro/**": true,
        "**/.output/**": true,
        "**/.serverless/**": true,
        "**/.pnpm-store/**": true,
        "**/node_modules/**": true,
        "**/dist/**": true,
        "**/build/**": true,
        "**/.git/**": true,
        "**/*.log": true,
        "**/__pycache__/**": true,
        "**/.pytest_cache/**": true,
        "**/.venv/**": true,
        "**/venv/**": true,
        "**/.next/**": true,
        "**/.nuxt/**": true,
        "**/.turbo/**": true,
        "**/.cache/**": true,
        "**/.mypy_cache/**": true,
        "**/.ruff_cache/**": true,
        "**/.tox/**": true,
        "**/.parcel-cache/**": true,
        "**/coverage/**": true
    },
    // ======================================================================
    // 10. Terminal
    // ======================================================================
    "terminal.integrated.minimumContrastRatio": 7,
    "terminal.integrated.smoothScrolling": false,
    "terminal.integrated.scrollback": 20000,
    "terminal.integrated.defaultProfile.linux": "bash",
    "terminal.integrated.defaultProfile.osx": "zsh",
    "terminal.integrated.defaultProfile.windows": "PowerShell",
    "terminal.integrated.enableMultiLinePasteWarning": "never",
    "terminal.integrated.enablePersistentSessions": true,
    "terminal.integrated.persistentSessionReviveProcess": "onExitAndWindowClose",
    "terminal.integrated.fontFamily": "'JetBrains Mono', 'JetBrainsMono Nerd Font', 'Fira Code', 'IBM Plex Mono', 'Monaspace Neon', 'Menlo', 'Monaco', monospace",
    "terminal.integrated.fontSize": 16,
    "terminal.integrated.fontWeight": "500",
    "terminal.integrated.lineHeight": 1.55,
    "terminal.integrated.cursorStyle": "line",
    "terminal.integrated.cursorBlinking": false,
    "terminal.integrated.cursorWidth": 2,
    "terminal.integrated.customGlyphs": true,
    "terminal.integrated.tabs.enabled": true,
    "terminal.integrated.tabs.hideCondition": "singleTerminal",
    "terminal.integrated.mouseWheelScrollSensitivity": 3,
    "terminal.integrated.copyOnSelection": true,
    // ======================================================================
    // 11. Git, diff, merge, AI tools
    // ======================================================================
    "git.decorations.enabled": true,
    "git.autorefresh": true,
    "git.autoRepositoryDetection": "subFolders",
    "git.detectSubmodules": true,
    "git.showPushSuccessNotification": true,
    "git.autofetch": true,
    "git.enableSmartCommit": true,
    "git.confirmSync": false,
    "git.openRepositoryInParentFolders": "always",
    "git.pruneOnFetch": true,
    "git.branchProtectionPrompt": "alwaysPrompt",
    "scm.defaultViewMode": "tree",
    "scm.showHistoryGraph": true,
    "scm.alwaysShowRepositories": true,
    "scm.diffDecorations": "all",
    "diffEditor.ignoreTrimWhitespace": false,
    "diffEditor.renderSideBySide": true,
    "diffEditor.wordWrap": "on",
    "diffEditor.hideUnchangedRegions.enabled": false,
    "diffEditor.showMoves": true,
    "diffEditor.diffAlgorithm": "advanced",
    "diffEditor.renderIndicators": true,
    "diffEditor.codeLens": true,
    "mergeEditor.enabled": true,
    "github.copilot.enable": {
        "*": true,
        "plaintext": true,
        "markdown": true,
        "scminput": true,
        "python": true,
        "csharp": true
    },
    "github.copilot.nextEditSuggestions.enabled": true,
    "gitlens.ai.model": "vscode",
    "gitlens.ai.vscode.model": "copilot:gpt-4.1",
    "chat.agent.maxRequests": 50,
    "chat.detectParticipant.enabled": false,
    "chat.viewSessions.orientation": "stacked",
    "claudeCode.preferredLocation": "panel",
    // ======================================================================
    // 12. Problems panel
    // ======================================================================
    "problems.showWarnings": true,
    "problems.showInfos": true,
    "problems.showCurrentInStatus": true,
    "problems.decorations.enabled": true,
    "problems.autoReveal": false,
    "problems.sortOrder": "severity",
    // ======================================================================
    // 13. Custom UI stylesheet — Glass Paper motion and chrome
    // ----------------------------------------------------------------------
    // Material system:
    //   quiet → title/status chrome
    //   raised → sidebars, panels, tabs
    //   widget → dialogs, command palette, suggestions
    // Hairline borders provide separation; motion communicates state, not decoration.
    // Requires Custom UI Style extension.
    // ======================================================================
    "custom-ui-style.stylesheet": {
        ".monaco-workbench": {
            "--nb-font-ui": "'Bear Sans UI', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
            "--nb-font-heading": "'Bear Sans UI Heading', 'Bear Sans UI', system-ui, sans-serif",
            "--nb-radius-panel": "14px",
            "--nb-radius-widget": "10px",
            "--nb-radius-input": "7px",
            "--nb-radius-item": "6px",
            "--nb-panel-gap": "6px",
            "--nb-panel-top": "6px",
            "--nb-canvas": "color-mix(in srgb, var(--vscode-editor-background) 85%, var(--vscode-foreground) 15%)",
            "--nb-surface": "color-mix(in srgb, var(--vscode-sideBar-background) 92%, transparent)",
            "--nb-surface-raised": "color-mix(in srgb, var(--vscode-editorWidget-background) 96%, transparent)",
            "--nb-surface-highlight": "color-mix(in srgb, var(--vscode-foreground) 8%, transparent)",
            "--nb-border": "color-mix(in srgb, var(--vscode-widget-border, var(--vscode-foreground)) 38%, transparent)",
            "--nb-border-subtle": "color-mix(in srgb, var(--vscode-widget-border, var(--vscode-foreground)) 20%, transparent)",
            "--nb-surface-shadow": "0 10px 28px color-mix(in srgb, var(--vscode-widget-shadow, #000000) 24%, transparent)",
            "--nb-glass-blur": "blur(12px)",
            "--nb-motion-fast": "120ms",
            "--nb-motion-base": "180ms",
            "--nb-motion-slow": "240ms",
            "--nb-ease-out": "cubic-bezier(0.16, 1, 0.3, 1)",
            "--nb-ease-in": "cubic-bezier(0.7, 0, 0.84, 0)",
            "--nb-ease-in-out": "cubic-bezier(0.65, 0, 0.35, 1)",
            "--nb-ease-spring": "cubic-bezier(0.34, 1.56, 0.64, 1)",
            "--nb-focus": "var(--vscode-focusBorder)",
            "background-color": "var(--nb-canvas) !important",
            "font-family": "var(--nb-font-ui) !important",
            "transition": "background-color var(--nb-motion-slow) var(--nb-ease-out), color var(--nb-motion-slow) var(--nb-ease-out) !important"
        },
        ".part.sidebar .title-label, .part.auxiliarybar .title-label, .part.panel.bottom .title-label": {
            "font-family": "var(--nb-font-heading) !important",
            "font-weight": "600 !important"
        },
        ".monaco-workbench .part, .monaco-workbench .monaco-list-row, .monaco-workbench .tab, .monaco-workbench .monaco-button": {
            "transition-timing-function": "var(--nb-ease-out) !important"
        },
        ".part.titlebar": {
            "background-color": "transparent !important",
            "border-bottom": "none !important",
            "box-shadow": "none !important",
            "transition": "background-color var(--nb-motion-slow) var(--nb-ease-out) !important"
        },
        ".part.statusbar": {
            "background-color": "var(--nb-surface) !important",
            "border-top": "1px solid var(--nb-border) !important",
            "border-radius": "var(--nb-radius-panel) var(--nb-radius-panel) 0 0 !important",
            "margin": "0 var(--nb-panel-gap) !important",
            "box-shadow": "none !important"
        },
        ".part.statusbar .statusbar-item-label": {
            "opacity": "0.9 !important",
            "transition": "opacity var(--nb-motion-fast) var(--nb-ease-out) !important"
        },
        ".part.statusbar:hover .statusbar-item-label": {
            "opacity": "1 !important"
        },
        ".part.sidebar, .part.auxiliarybar, .part.panel.bottom": {
            "background-color": "var(--nb-surface) !important",
            "border": "1px solid var(--nb-border) !important",
            "border-radius": "var(--nb-radius-panel) !important",
            "margin": "var(--nb-panel-top) var(--nb-panel-gap) var(--nb-panel-gap) var(--nb-panel-gap) !important",
            "box-shadow": "var(--nb-surface-shadow) !important"
        },
        ".part.editor": {
            "background-color": "var(--vscode-editor-background) !important",
            "border": "1px solid var(--nb-border) !important",
            "border-radius": "var(--nb-radius-panel) !important",
            "margin": "var(--nb-panel-top) var(--nb-panel-gap) var(--nb-panel-gap) 0 !important",
            "overflow": "hidden !important",
            "box-shadow": "var(--nb-surface-shadow) !important"
        },
        ".part.activitybar": {
            "background-color": "var(--nb-surface) !important",
            "border": "1px solid var(--nb-border) !important",
            "border-radius": "999px !important",
            "margin": "var(--nb-panel-top) 0 var(--nb-panel-gap) var(--nb-panel-gap) !important",
            "box-shadow": "var(--nb-surface-shadow) !important"
        },
        ".part.activitybar .action-item": {
            "border-radius": "999px !important",
            "transition": "background-color var(--nb-motion-fast) var(--nb-ease-out), transform var(--nb-motion-fast) var(--nb-ease-out) !important"
        },
        ".part.activitybar .action-item:hover": {
            "background-color": "var(--nb-surface-highlight) !important"
        },
        ".part.activitybar .action-item.checked": {
            "background-color": "var(--nb-surface-highlight) !important",
            "border-radius": "999px !important"
        },
        ".tabs-and-actions-container": {
            "background-color": "transparent !important",
            "border-bottom": "1px solid var(--nb-border) !important"
        },
        ".tab": {
            "position": "relative !important",
            "border-radius": "var(--nb-radius-item) !important",
            "margin": "3px 2px !important",
            "transition": "background-color var(--nb-motion-fast) var(--nb-ease-out), color var(--nb-motion-fast) var(--nb-ease-out) !important"
        },
        ".tab .tab-close-action": {
            "opacity": "0 !important",
            "transition": "opacity var(--nb-motion-fast) var(--nb-ease-out) !important"
        },
        ".tab:hover .tab-close-action": {
            "opacity": "0.9 !important"
        },
        ".tab::after": {
            "content": "'' !important",
            "position": "absolute !important",
            "left": "50% !important",
            "bottom": "0 !important",
            "height": "2px !important",
            "border-radius": "999px !important",
            "background-color": "var(--vscode-tab-activeBorder, var(--vscode-focusBorder)) !important",
            "transform": "translateX(-50%) scaleX(0) !important",
            "transform-origin": "center !important",
            "opacity": "0 !important",
            "transition": "transform var(--nb-motion-slow) var(--nb-ease-out), opacity var(--nb-motion-fast) var(--nb-ease-out) !important"
        },
        ".tab:hover::after": {
            "opacity": "0.75 !important",
            "transform": "translateX(-50%) scaleX(0.45) !important"
        },
        ".tab.active::after": {
            "opacity": "1 !important",
            "transform": "translateX(-50%) scaleX(1) !important"
        },
        ".tab:hover": {
            "background-color": "var(--vscode-tab-hoverBackground) !important"
        },
        ".tab.active": {
            "background-color": "var(--vscode-tab-activeBackground) !important"
        },
        ".monaco-breadcrumbs": {
            "opacity": "0.75 !important",
            "transition": "opacity var(--nb-motion-fast) var(--nb-ease-out) !important"
        },
        ".monaco-breadcrumbs:hover": {
            "opacity": "1 !important"
        },
        ".monaco-list-row": {
            "border-radius": "var(--nb-radius-item) !important",
            "margin-top": "1px !important",
            "margin-bottom": "1px !important",
            "transition": "background-color var(--nb-motion-fast) var(--nb-ease-out), color var(--nb-motion-fast) var(--nb-ease-out) !important"
        },
        ".monaco-list-row.focused": {
            "outline": "1px solid var(--nb-focus) !important",
            "outline-offset": "-1px !important"
        },
        ".monaco-list-row:hover": {
            "transform": "none !important"
        },
        ".monaco-inputbox, .monaco-findInput, .scm-input, .scm-editor": {
            "border-radius": "var(--nb-radius-input) !important",
            "border": "1px solid var(--nb-border) !important",
            "background-color": "var(--vscode-input-background) !important",
            "transition": "border-color var(--nb-motion-fast) var(--nb-ease-out), box-shadow var(--nb-motion-fast) var(--nb-ease-out) !important"
        },
        ".monaco-inputbox.focused, .monaco-findInput.focused, .scm-input:focus-within, .scm-editor:focus-within": {
            "border-color": "var(--nb-focus) !important",
            "box-shadow": "0 0 0 2px color-mix(in srgb, var(--nb-focus) 28%, transparent) !important"
        },
        ".monaco-button": {
            "border-radius": "var(--nb-radius-input) !important",
            "transition": "background-color var(--nb-motion-fast) var(--nb-ease-out), color var(--nb-motion-fast) var(--nb-ease-out), border-color var(--nb-motion-fast) var(--nb-ease-out), transform var(--nb-motion-fast) var(--nb-ease-out) !important"
        },
        ".monaco-button:hover, .action-label:hover": {
            "transform": "none !important"
        },
        ".monaco-button:active, .action-label:active": {
            "transform": "scale(0.98) !important",
            "transition": "transform var(--nb-motion-fast) var(--nb-ease-in) !important"
        },
        ".monaco-workbench :focus-visible": {
            "outline": "2px solid var(--nb-focus) !important",
            "outline-offset": "2px !important",
            "animation": "none !important"
        },
        ".quick-input-widget": {
            "border-radius": "var(--nb-radius-widget) !important",
            "background-color": "var(--nb-surface-raised) !important",
            "border": "1px solid var(--nb-border) !important",
            "box-shadow": "var(--nb-surface-shadow) !important",
            "backdrop-filter": "var(--nb-glass-blur) !important",
            "-webkit-backdrop-filter": "var(--nb-glass-blur) !important",
            "animation": "nb-settle-in var(--nb-motion-slow) var(--nb-ease-out) both !important"
        },
        ".suggest-widget": {
            "border-radius": "var(--nb-radius-widget) !important",
            "background-color": "var(--nb-surface-raised) !important",
            "border": "1px solid var(--nb-border) !important",
            "box-shadow": "var(--nb-surface-shadow) !important",
            "backdrop-filter": "var(--nb-glass-blur) !important",
            "-webkit-backdrop-filter": "var(--nb-glass-blur) !important",
            "animation": "nb-settle-in var(--nb-motion-slow) var(--nb-ease-out) both !important"
        },
        ".monaco-hover": {
            "border-radius": "var(--nb-radius-widget) !important",
            "background-color": "var(--nb-surface-raised) !important",
            "border": "1px solid var(--nb-border) !important",
            "box-shadow": "var(--nb-surface-shadow) !important",
            "backdrop-filter": "var(--nb-glass-blur) !important",
            "-webkit-backdrop-filter": "var(--nb-glass-blur) !important",
            "animation": "nb-settle-in var(--nb-motion-base) var(--nb-ease-out) both !important"
        },
        ".monaco-dialog-box": {
            "border-radius": "var(--nb-radius-widget) !important",
            "background-color": "var(--nb-surface-raised) !important",
            "border": "1px solid var(--nb-border) !important",
            "box-shadow": "var(--nb-surface-shadow) !important",
            "backdrop-filter": "var(--nb-glass-blur) !important",
            "-webkit-backdrop-filter": "var(--nb-glass-blur) !important",
            "animation": "nb-settle-in var(--nb-motion-slow) var(--nb-ease-out) both !important"
        },
        ".notification-toast": {
            "border-radius": "var(--nb-radius-widget) !important",
            "background-color": "var(--nb-surface-raised) !important",
            "border": "1px solid var(--nb-border) !important",
            "box-shadow": "var(--nb-surface-shadow) !important",
            "backdrop-filter": "var(--nb-glass-blur) !important",
            "-webkit-backdrop-filter": "var(--nb-glass-blur) !important",
            "animation": "nb-toast-in var(--nb-motion-slow) var(--nb-ease-out) both !important"
        },
        ".notifications-center": {
            "border-radius": "var(--nb-radius-widget) !important",
            "background-color": "var(--nb-surface-raised) !important",
            "border": "1px solid var(--nb-border) !important",
            "box-shadow": "var(--nb-surface-shadow) !important",
            "backdrop-filter": "var(--nb-glass-blur) !important",
            "-webkit-backdrop-filter": "var(--nb-glass-blur) !important",
            "animation": "nb-settle-in var(--nb-motion-slow) var(--nb-ease-out) both !important"
        },
        ".monaco-menu": {
            "border-radius": "var(--nb-radius-widget) !important",
            "background-color": "var(--nb-surface-raised) !important",
            "border": "1px solid var(--nb-border) !important",
            "box-shadow": "var(--nb-surface-shadow) !important",
            "backdrop-filter": "var(--nb-glass-blur) !important",
            "-webkit-backdrop-filter": "var(--nb-glass-blur) !important",
            "animation": "nb-settle-in var(--nb-motion-fast) var(--nb-ease-out) both !important"
        },
        ".quick-input-widget .monaco-list-row.focused, .suggest-widget .monaco-list-row.focused": {
            "outline": "1px solid var(--nb-focus) !important",
            "background-color": "var(--vscode-quickInputList-focusBackground) !important"
        },
        ".settings-editor .setting-item, .settings-editor .setting-item-contents": {
            "border-radius": "var(--nb-radius-widget) !important",
            "border": "1px solid var(--nb-border) !important",
            "background-color": "var(--nb-surface) !important",
            "padding": "14px 18px !important",
            "margin-bottom": "8px !important",
            "box-shadow": "none !important",
            "transition": "border-color var(--nb-motion-fast) var(--nb-ease-out), background-color var(--nb-motion-fast) var(--nb-ease-out) !important"
        },
        ".settings-editor .setting-item:hover, .settings-editor .setting-item-contents:hover": {
            "border-color": "var(--vscode-focusBorder) !important",
            "transform": "none !important"
        },
        ".settings-editor .setting-item.setting-item-modified .setting-item-contents": {
            "border-left": "3px solid var(--vscode-settings-modifiedItemIndicator) !important"
        },
        ".monaco-progress-container .progress-bit": {
            "animation": "nb-progress-sweep 900ms var(--nb-ease-in-out) infinite !important"
        },
        ".monaco-scrollable-element > .scrollbar.vertical": {
            "width": "14px !important"
        },
        ".monaco-scrollable-element > .scrollbar.vertical > .slider": {
            "width": "6px !important",
            "margin-left": "4px !important",
            "border-radius": "999px !important"
        },
        ".monaco-scrollable-element > .scrollbar > .slider:hover": {
            "background": "var(--vscode-scrollbarSlider-hoverBackground) !important"
        },
        ".monaco-sash:hover": {
            "background-color": "var(--vscode-sash-hoverBorder) !important",
            "box-shadow": "none !important"
        },
        ".command-center-center": {
            "border-radius": "999px !important",
            "border": "1px solid var(--nb-border) !important",
            "background-color": "var(--nb-surface) !important",
            "box-shadow": "none !important"
        },
        ".monaco-editor .cursor": {
            "filter": "none !important",
            "animation": "none !important"
        },
        "@keyframes nb-settle-in": {
            "from": {
                "opacity": "0",
                "transform": "translateY(5px)"
            },
            "to": {
                "opacity": "1",
                "transform": "translateY(0)"
            }
        },
        "@keyframes nb-toast-in": {
            "from": {
                "opacity": "0",
                "transform": "translateX(8px)"
            },
            "to": {
                "opacity": "1",
                "transform": "translateX(0)"
            }
        },
        "@keyframes nb-progress-sweep": {
            "0%": {
                "opacity": "0",
                "transform": "translateX(-100%)"
            },
            "40%": {
                "opacity": "1"
            },
            "100%": {
                "opacity": "1",
                "transform": "translateX(100%)"
            }
        },
        "@media (prefers-reduced-transparency: reduce)": {
            ".monaco-workbench": {
                "--nb-surface": "var(--vscode-sideBar-background)",
                "--nb-surface-raised": "var(--vscode-editorWidget-background)"
            },
            ".quick-input-widget, .suggest-widget, .monaco-hover, .monaco-dialog-box, .notification-toast, .notifications-center, .monaco-menu": {
                "backdrop-filter": "none !important",
                "-webkit-backdrop-filter": "none !important"
            }
        },
        "@media (prefers-reduced-motion: reduce)": {
            ".monaco-workbench, .monaco-workbench *": {
                "transition-duration": "0ms !important",
                "animation": "none !important",
                "scroll-behavior": "auto !important"
            },
            ".tab::after, .monaco-progress-container .progress-bit": {
                "animation": "none !important",
                "transition": "none !important",
                "opacity": "1 !important",
                "transform": "translateX(-50%) scaleX(1) !important"
            },
            ".monaco-button:active, .action-label:active": {
                "transform": "none !important"
            }
        }
    },
    // ======================================================================
    // 14. Language-specific settings
    // ======================================================================
    "[javascript]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true
    },
    "[typescript]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true
    },
    "[typescriptreact]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true
    },
    "[python]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "[html]": {
        "editor.tabSize": 2
    },
    "[css]": {
        "editor.tabSize": 2
    },
    "[json]": {
        "editor.tabSize": 4
    },
    "[jsonc]": {
        "editor.tabSize": 4
    },
    "workbench.editor.tabActionLocation": "right",
    // ======================================================================
    // Theme-specific color customizations — high-alpha glass chrome
    // ----------------------------------------------------------------------
    // Lower opacity so backdrop-filter can frost through. Tabs header stays
    // fully transparent so the editor card glass reads continuously.
