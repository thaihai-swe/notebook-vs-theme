        // ------------------------------------------------------------------
        ".monaco-count-badge": {
            "border-radius": "var(--nb-pill-radius) !important",
            "padding": "0 8px !important",
            "min-height": "17px !important",
            "line-height": "17px !important",
            "font-size": "11px !important",
            "font-weight": "650 !important",
            "box-shadow": "var(--nb-specular) !important"
        },
        ".sticky-widget": {
            "backdrop-filter": "var(--nb-blur-thin) !important",
            "-webkit-backdrop-filter": "var(--nb-blur-thin) !important",
            "box-shadow": "0 8px 20px -8px rgba(0, 0, 0, 0.2), var(--nb-specular) !important",
            "border-bottom": "var(--nb-hairline-soft) !important"
        },
        ".chat-input-container, .interactive-input-part": {
            "border-radius": "var(--nb-widget-radius) !important",
            "overflow": "visible !important",
            "background-color": "var(--nb-glass-regular) !important",
            "backdrop-filter": "var(--nb-blur-regular) !important",
            "-webkit-backdrop-filter": "var(--nb-blur-regular) !important",
            "border": "var(--nb-hairline) !important",
            "box-shadow": "var(--nb-elev-2), var(--nb-specular) !important"
        },
        ".chat-editing-session-container, .chat-confirmation-widget2": {
